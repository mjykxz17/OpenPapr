# Path to the SQLite database file (relative to the repo root).
DATABASE_PATH=data/openpapr.db

# 64 hex chars, used to encrypt stored credentials. Generate with: openssl rand -hex 32
SECRET_KEY=

# Password required to access the dashboard (min 8 chars).
APP_PASSWORD=

# Base URL of the Canvas instance to poll.
CANVAS_BASE_URL=https://canvas.nus.edu.sg

# Microsoft Entra ID app client ID, for NUS Outlook/Graph API access (optional).
MS_CLIENT_ID=

# Anthropic API key, used for AI-assisted features (optional).
ANTHROPIC_API_KEY=

# Anthropic model name used for AI-assisted features.
ANTHROPIC_MODEL=claude-haiku-4-5

# How often the worker polls Canvas/Outlook, in milliseconds.
POLL_INTERVAL_MS=300000

# OpenAI-compatible provider — takes precedence over Anthropic when both are set.
# Any endpoint speaking the OpenAI chat-completions API works unchanged: OpenAI
# itself, OpenRouter, Groq, Together, or a local Ollama/vLLM server.
#
# OpenAI:
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=sk-...
# OPENAI_COMPAT_MODEL=gpt-4o-mini
#
# Local Ollama:
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=ollama
# OPENAI_COMPAT_MODEL=llama3.1
#
# Note: requests send `max_tokens`. OpenAI's newer reasoning models expect
# `max_completion_tokens` instead and will reject it; the gpt-4o family is fine.
# Azure OpenAI is NOT drop-in — it uses an `api-key` header and a
# /openai/deployments/<name>/chat/completions?api-version=... path.
#
# PDF syllabus sources are only used on the Anthropic path.
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
