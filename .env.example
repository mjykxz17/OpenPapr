# Path to the SQLite database file (relative to the repo root).
DATABASE_PATH=data/openpapr.db

# 64 hex chars, used to encrypt stored credentials. Generate with: openssl rand -hex 32
SECRET_KEY=

# Password required to access the dashboard (min 8 chars).
APP_PASSWORD=

# Base URL of the Canvas instance to poll.
CANVAS_BASE_URL=https://canvas.nus.edu.sg

# Microsoft Entra ID app client ID, for NUS Outlook/Graph API access (optional).
MS_CLIENT_ID=

# Anthropic API key, used for AI-assisted features (optional).
ANTHROPIC_API_KEY=

# Anthropic model name used for AI-assisted features.
ANTHROPIC_MODEL=claude-haiku-4-5

# How often the worker polls Canvas/Outlook, in milliseconds.
POLL_INTERVAL_MS=300000

# OpenAI-compatible provider (e.g. Agnes agrouter) — takes precedence over Anthropic when set.
# PDF syllabus sources are only used on the Anthropic path.
# OPENAI_COMPAT_BASE_URL=https://your-openai-compatible-host/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=agnes-2.5-flash
